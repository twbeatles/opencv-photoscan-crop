# Build artifacts
;opencv/build/
;opencv/dist/
build/
dist/

# Local debug / benchmark artifacts
;opencv/_debug/
;opencv/benchmark/images/
;opencv/benchmark/reports/
;opencv/benchmark/labels.json
;opencv/benchmark/report.json
;opencv/benchmark/report-*.json

# Runtime output artifacts from local processing
**/output_cropped/
**/_failed/
**/backup/
**/_debug/
**/*_photos/
*.photocropper

# PyInstaller cache
*.spec.bak

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Ruff cache
.ruff_cache/
;opencv/.ruff_cache/

# Local backups / ad-hoc reports
backups/
pyright_report.json
pyright_report*.json
;opencv/pyright_report.json
;opencv/pyright_report*.json
;opencv/convert_icon.py

# Runtime processed-index cache (skip_processed v2)
**/.photocropper/

# Test / type-check / coverage caches
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.nox/
.tox/
.coverage*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE / OS noise
.idea/
.vscode/
Thumbs.db
.DS_Store
