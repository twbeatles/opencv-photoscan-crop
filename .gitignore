# Build artifacts
;opencv/build/
;opencv/dist/
build/
dist/

# Local debug / benchmark artifacts
;opencv/_debug/
;opencv/benchmark/images/
;opencv/benchmark/reports/
;opencv/benchmark/labels.json
;opencv/benchmark/report.json
;opencv/benchmark/report-*.json

# PyInstaller cache
*.spec.bak

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Ruff cache
;opencv/.ruff_cache/

# Local backups / ad-hoc reports
backups/
;opencv/pyright_report.json
;opencv/pyright_report*.json

# Runtime processed-index cache (skip_processed v2)
**/.photocropper/

# Test / type-check / coverage caches
.pytest_cache/
.mypy_cache/
.nox/
.tox/
.coverage*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE / OS noise
.idea/
.vscode/
Thumbs.db
.DS_Store
